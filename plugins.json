    },
    {
      "id": "skills",
      "name": "技能包与提示词",
      "summary": "以 Skill / Prompt 形式交付的方法论、模板与提示词资产。"
    },
    {
      "id": "tools-runtime",
      "name": "工具与运行时",
      "summary": "文件、Shell、终端等底层执行能力的替代或增强实现。"
    },
    {
      "id": "office-media",
      "name": "办公文档与多媒体",
      "summary": "Office 文档、表格、演示稿与视频创作能力。"
    },
    {
      "id": "search-knowledge",
      "name": "联网搜索与知识",
      "summary": "全网检索、网页读取、站内搜索与知识库能力。"
    },
    {
      "id": "integration",
      "name": "外部集成与通信",
      "summary": "浏览器控制、IM 平台、模型来源、跨 Agent 记忆等对外连接。"
    },
    {
      "id": "safety",
      "name": "安全与治理",
      "summary": "危险命令拦截、敏感文件保护等执行前安全闸门。"
    }
