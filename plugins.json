{
  "$schema": "./schema/plugins.schema.json",
  "meta": {
    "repo": "dsh-plugin-recommendations",
    "description": "DSH (DeepSeek Harness) 插件推荐仓库：收录本机已安装插件的上游 GitHub 仓库地址、分类与上游原生安装方式。",
    "generatedAt": "2026-10-20",
    "dshVersion": "0.2.0-rc.2",
    "sourceProfile": "web",
    "sourceCommand": "dsh plugin --profile web list",
    "conventions": {
      "install": "install 字段一律为【上游仓库 README / 源码原文】给出的 DSH 安装方式，逐字回放，不自造命令。",
      "profile": "命令中的 profile 名以 {profile} 占位，实际执行时替换为目标 profile（web / dsh-tui / desktop / headless）。",
      "registry": "部分上游显式指定 --registry=https://registry.npmjs.org/，该参数是上游原文的一部分，不做删减。",
      "notPublic": "notPublic=true 表示该条目无法从公共渠道安装（私有包或本地 link），安装命令仅供本机/内网环境参考。",
      "selfDeveloped": "selfDeveloped=true 表示该插件由本仓库维护者自研，不是第三方收录；README 与清单中以 🏠 自研 标注。"
    },
    "presets": [
      {
        "id": "market",
        "name": "市场与入口",
        "description": "先把插件市场装上，后面所有插件都能在里面图形化安装。",
        "pluginIds": ["dshmarket", "d-prompt", "mattpocock-skills-deck"]
      },
      {
        "id": "shell",
        "name": "界面与外壳",
        "description": "改变 DSH Web 观感与操作方式的一组插件。",
        "pluginIds": ["better-sidebar", "client-ui-git-graph", "codex-ui", "genui"]
      },
      {
        "id": "orchestration",
        "name": "多智能体协作",
        "description": "团队协作、专家智能体与 Agent 预设。",
        "pluginIds": ["agent-teams", "agency-agents", "clearai"]
      },
      {
        "id": "dev",
        "name": "开发效率",
        "description": "代码审查、简化、上下文治理、任务回退与归档。",
        "pluginIds": ["code-review", "simplify", "context", "rewind", "archive-manager", "btw", "automation"]
      },
      {
        "id": "skills",
        "name": "技能与提示词",
        "description": "以 Skill / Prompt 形式交付的方法论资产。",
        "pluginIds": ["skills-manager", "qa-skills", "archify", "lunheng"]
      },
      {
        "id": "tooling",
        "name": "工具与运行时",
        "description": "文件 / Shell / 终端等底层执行能力。",
        "pluginIds": ["ops"]
      },
      {
        "id": "office",
        "name": "办公与多媒体",
        "description": "Office 文档、表格、演示稿与视频。",
        "pluginIds": ["univer-office", "remotion"]
      },
      {
        "id": "search",
        "name": "联网搜索",
        "description": "让 Agent 能查全网、读网页。",
        "pluginIds": ["modsearch"]
      },
      {
        "id": "integration",
        "name": "外部集成",
        "description": "浏览器、IM、模型来源、跨 Agent 记忆。",
        "pluginIds": ["browser-skill", "im-connect", "opencode2dsh", "workbuddy-connect", "subusage", "pocket", "omp-memory", "clawd-bridge"]
      },
      {
        "id": "safety",
        "name": "安全闸门",
        "description": "危险命令与敏感文件访问的拦截。",
        "pluginIds": ["cc-safety-net"]
      },
      {
        "id": "public-full",
        "name": "全部可公开安装的插件",
        "description": "除私有条目（clawd-bridge）外的全部插件。",
        "pluginIds": [
          "dshmarket", "d-prompt", "mattpocock-skills-deck", "better-sidebar",
          "client-ui-git-graph", "codex-ui", "genui", "agent-teams", "agency-agents",
          "clearai", "code-review", "simplify", "context", "rewind", "archive-manager",
          "btw", "automation", "skills-manager", "qa-skills", "archify", "lunheng",
          "ops", "univer-office", "remotion", "modsearch", "browser-skill",
          "im-connect", "opencode2dsh", "workbuddy-connect", "subusage", "pocket",
          "cc-safety-net", "omp-memory"
        ]
      }
    ]
  },
  "categories": [
    {
      "id": "market",
      "name": "插件市场与分发",
